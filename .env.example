# Create a token in the AgentRouter console and paste it here.
# Do not commit this file. Rotate any token that has been pasted into a chat.
AGENTROUTER_API_KEY=

# Public Arc mainnet address that receives scan payments. Returned on HTTP 402.
PAY_TO_WALLET=

# Optional. One Etherscan API V2 key adds transaction history for Base, Arbitrum,
# Polygon, and BNB Chain. Without it, those chains still return scam labels,
# balances, outgoing counts, and age when the chain itself can provide them.
ETHERSCAN_API_KEY=
